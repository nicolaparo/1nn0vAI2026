@if (Orders is null)
{
    <div class="p-4 text-center text-secondary">
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Loading orders...
    </div>
}
else if (Orders.Count == 0)
{
    <div class="p-4 text-center text-secondary">@EmptyMessage</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Order</th>
                    @if (ShowCustomer)
                    {
                        <th scope="col">Customer</th>
                    }
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Total due</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Orders)
                {
                    <tr data-testid="order-row">
                        <td class="fw-semibold">#@order.SalesOrderID</td>
                        @if (ShowCustomer)
                        {
                            <td>
                                <a href="@($"customers/{order.CustomerID}")">
                                    @(string.IsNullOrWhiteSpace(order.CustomerName) ? $"Customer {order.CustomerID}" : order.CustomerName)
                                </a>
                            </td>
                        }
                        <td>@order.OrderDate.ToString("d")</td>
                        <td><span class="badge text-bg-secondary">@order.StatusText</span></td>
                        <td class="text-end">@order.TotalDue.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<OrderSummary>? Orders { get; set; }

    [Parameter]
    public bool ShowCustomer { get; set; } = true;

    [Parameter]
    public string EmptyMessage { get; set; } = "No orders found.";
}
