@inject ExternalComponentCompiler Compiler
@inject PageUpdateWorkspace Workspace
@implements IDisposable

@if (pageType is null)
{
    <div class="text-secondary">
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Loading page...
    </div>
}
else
{
    <DynamicComponent Type="pageType" Parameters="Parameters" />
}

@code {
    [Parameter, EditorRequired]
    public string PageName { get; set; } = string.Empty;

    [Parameter]
    public IDictionary<string, object>? Parameters { get; set; }

    private Type? pageType;

    protected override async Task OnParametersSetAsync()
    {
        pageType = await Compiler.CompileAsync(
            PageName,
            Workspace.GetActivePagePath(PageName));
    }

    protected override void OnInitialized()
    {
        Workspace.Changed += HandleWorkspaceChanged;
    }

    public void Dispose()
    {
        Workspace.Changed -= HandleWorkspaceChanged;
    }

    private async Task HandleWorkspaceChanged()
    {
        await InvokeAsync(async () =>
        {
            pageType = await Compiler.CompileAsync(
                PageName,
                Workspace.GetActivePagePath(PageName));
            StateHasChanged();
        });
    }
}
