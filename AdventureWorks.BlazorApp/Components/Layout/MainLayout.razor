@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject PageUpdateService PageUpdateService

<div class="d-flex min-vh-100">
    <NavMenu />

    <div class="d-flex flex-column flex-grow-1 bg-body-tertiary">
        <header class="d-flex justify-content-between align-items-center bg-white border-bottom px-4 py-2 sticky-top">
            <span class="fw-semibold text-secondary">
                <i class="fa-solid fa-building me-2"></i>AdventureWorks Cycles
            </span>
            <div class="d-flex align-items-center gap-3">
                <a class="btn btn-light btn-sm" href="https://learn.microsoft.com/aspnet/core/" target="_blank">
                    <i class="fa-solid fa-circle-question me-1"></i>About
                </a>
                <span class="text-secondary small"><i class="fa-solid fa-user me-1"></i>Administrator</span>
            </div>
        </header>

        <main class="flex-grow-1 p-4 app-page-content">
            @Body
        </main>

        <footer class="app-page-footer border-top bg-white p-3">
            <div class="d-flex align-items-center gap-2">
                <label class="visually-hidden" for="page-update-message">Describe a page update</label>
                <input id="page-update-message" class="form-control"
                       type="text" @bind="pageUpdateMessage"
                       placeholder="Describe how you want this page updated"
                       disabled="@isSubmitting" />
                <button class="btn btn-primary text-nowrap" type="button"
                        @onclick="SubmitPageUpdateAsync" disabled="@isSubmitting">
                    <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>Submit
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(updateStatus))
            {
                <div class="small mt-2 @(updateFailed ? "text-danger" : "text-secondary")"
                     role="status">@updateStatus</div>
            }
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? pageUpdateMessage;
    private string? updateStatus;
    private bool updateFailed;
    private bool isSubmitting;

    protected override void OnInitialized()
    {
        PageUpdateService.ProgressChanged += HandleProgressChangedAsync;
    }

    private async Task SubmitPageUpdateAsync()
    {
        if (string.IsNullOrWhiteSpace(pageUpdateMessage) ||
            PageUpdateWorkspace.ResolvePageName(Navigation.Uri) is not { } pageName)
        {
            updateFailed = true;
            updateStatus = "Enter a request while viewing an editable page.";
            return;
        }

        var request = pageUpdateMessage;
        pageUpdateMessage = null;
        isSubmitting = true;
        updateFailed = false;
        updateStatus = "Copilot is updating this page...";
        try
        {
            await PageUpdateService.UpdatePageAsync(pageName, request);
            updateStatus = "Page updated successfully.";
        }
        catch (OperationCanceledException)
        {
            updateFailed = true;
            updateStatus = "The page update was canceled.";
        }
        catch (InvalidOperationException exception)
        {
            updateFailed = true;
            updateStatus = $"The page was not updated: {exception.Message}";
        }
        catch (IOException exception)
        {
            updateFailed = true;
            updateStatus = $"The page was not updated: {exception.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleProgressChangedAsync(string message)
    {
        updateStatus = message;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PageUpdateService.ProgressChanged -= HandleProgressChangedAsync;
    }
}
