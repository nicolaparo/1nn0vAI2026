@page "/"
@rendermode InteractiveServer
@inject CustomerService CustomerService
@inject OrderService OrderService

<PageTitle>Dashboard</PageTitle>

<h1 class="h3 mb-4"><i class="fa-solid fa-gauge-high me-2 text-primary"></i>Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <KpiCard Title="Customers" Value="@customerCount.ToString("N0")" Icon="fa-solid fa-users" Color="primary" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <KpiCard Title="Orders" Value="@orderCount.ToString("N0")" Icon="fa-solid fa-file-invoice" Color="success" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <KpiCard Title="Revenue" Value="@totalRevenue.ToString("C0")" Icon="fa-solid fa-sack-dollar" Color="warning" />
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <KpiCard Title="Avg. order value" Value="@averageOrderValue.ToString("C0")" Icon="fa-solid fa-chart-line" Color="info" />
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-clock-rotate-left me-2 text-secondary"></i>Recent orders</span>
        <a class="btn btn-primary btn-sm" href="orders">View all</a>
    </div>
    <OrderTable Orders="recentOrders" />
</div>

@code {
    private IReadOnlyList<OrderSummary>? recentOrders;
    private int customerCount;
    private int orderCount;
    private decimal totalRevenue;
    private decimal averageOrderValue;

    protected override async Task OnInitializedAsync()
    {
        customerCount = await CustomerService.GetCustomerCountAsync();
        orderCount = await OrderService.GetOrderCountAsync();
        totalRevenue = await OrderService.GetTotalRevenueAsync();
        averageOrderValue = orderCount == 0 ? 0 : totalRevenue / orderCount;
        recentOrders = await OrderService.GetOrdersAsync(10);
    }
}
