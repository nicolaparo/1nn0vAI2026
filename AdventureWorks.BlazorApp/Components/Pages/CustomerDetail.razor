@page "/customers/{CustomerId:int}"
@rendermode InteractiveServer
@inject ICustomerService CustomerService
@inject IOrderService OrderService

<PageTitle>Customer details</PageTitle>

<ExternalComponent PageName="CustomCustomerDetailPage.razor"
              Parameters="pageParameters" />

@code {
    [Parameter] public int CustomerId { get; set; }
    private Dictionary<string, object> pageParameters => new() { [nameof(CustomerId)] = CustomerId };
}
