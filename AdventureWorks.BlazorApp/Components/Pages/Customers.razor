@page "/customers"
@rendermode InteractiveServer
@inject CustomerService CustomerService

<PageTitle>Customers</PageTitle>

<h1 class="h3 mb-4"><i class="fa-solid fa-users me-2 text-primary"></i>Customers</h1>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input class="form-control" type="search" placeholder="Filter by company name"
                           aria-label="Filter by company name"
                           @bind="companyName" @bind:event="oninput" @onkeyup="OnSearchKeyUpAsync" />
                    <button class="btn btn-primary" type="button" @onclick="SearchAsync">Search</button>
                </div>
            </div>
        </div>
    </div>

    @if (customers is null)
    {
        <div class="p-4 text-center text-secondary">
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Loading customers...
        </div>
    }
    else if (customers.Count == 0)
    {
        <div class="p-4 text-center text-secondary">No customers match the current filter.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Company</th>
                        <th scope="col">Contact</th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in customers)
                    {
                        <tr data-testid="customer-row">
                            <td class="text-secondary">@customer.CustomerID</td>
                            <td class="fw-semibold">@customer.DisplayName</td>
                            <td>@customer.ContactName</td>
                            <td>@customer.EmailAddress</td>
                            <td>@customer.Phone</td>
                            <td class="text-end">
                                <a class="btn btn-secondary btn-sm" href="@($"customers/{customer.CustomerID}")"
                                   aria-label="@($"Open customer {customer.CustomerID}")">
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<CustomerProfile>? customers;    private string? companyName;

    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task SearchAsync()
    {
        customers = null;
        customers = await CustomerService.SearchCustomersAsync(companyName);
    }

    private async Task OnSearchKeyUpAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }
}
