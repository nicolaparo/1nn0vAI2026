<div class="card border-0 shadow-sm h-100" data-testid="kpi-card">
    <div class="card-body d-flex align-items-center gap-3">
        <span class="kpi-icon rounded-circle d-flex align-items-center justify-content-center text-bg-@Color">
            <i class="@Icon"></i>
        </span>
        <div>
            <div class="text-secondary text-uppercase small fw-semibold">@Title</div>
            <div class="fs-4 fw-bold">@Value</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required string Value { get; set; }

    [Parameter, EditorRequired]
    public required string Icon { get; set; }

    [Parameter]
    public string Color { get; set; } = "primary";
}
